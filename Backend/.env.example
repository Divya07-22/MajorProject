# ==============================================================================
# FRAUD DETECTION SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- Flask & JWT Configuration ---
SECRET_KEY=your_flask_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# --- Database Configuration ---
#DATABASE_URL=postgresql://postgres:your_password@localhost:5432/fraud_prevention_db
DATABASE_URL=sqlite:///fraud_prevention.db

MONGO_URI=mongodb://localhost:27017/fraud_logs_db

# --- Blockchain Configuration ---
INFURA_URL=http://127.0.0.1:7545
SIGNER_PRIVATE_KEY=your_private_key_here

# --- Contract Addresses ---
# Smart Contract Addresses
FRAUD_MITIGATOR_CONTRACT_ADDRESS=your_fraud_mitigator_contract_address_here
FRAUD_LEDGER_CONTRACT_ADDRESS=your_fraud_ledger_contract_address_here
VERIFIER_CONTRACT_ADDRESS=your_verifier_contract_address_here

# Server/Owner Account
SERVER_WALLET_ADDRESS=your_server_wallet_address_here

# --- Twilio Configuration ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# --- Public URL ---
PUBLIC_URL=your_ngrok_or_public_url_here

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Polygon Layer-2 Configuration
POLYGON_RPC_URL=https://rpc-mumbai.maticvigil.com/
POLYGON_CHAIN_ID=80001
